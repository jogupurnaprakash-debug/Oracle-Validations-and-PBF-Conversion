# Oracle database connection settings
ORACLE_HOST=your-oracle-host
ORACLE_PORT=1521
ORACLE_SERVICE=your-service-name
ORACLE_USER=your-username
ORACLE_PASSWORD=your-password

# Optional app login for shared Streamlit access
APP_LOGIN_USER=validator
APP_LOGIN_PASSWORD=change-me

# Authentication mode for the Streamlit app: "oracle" (recommended) or "app"
APP_AUTH_MODE=oracle
